{
  "name": "@williamzheng0711/journey-sphere",
  "version": "0.2.0",
  "description": "A reusable land-only visited-region map with a versioned atlas and compact travel state.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./compiled": "./src/compiled.js",
    "./state": "./src/state.js",
    "./style.css": "./src/style.css",
    "./data/*": "./data/*",
    "./embed.js": "./src/embed.js",
    "./embed": "./embed.js",
    "./places": "./src/places.js"
  },
  "files": [
    "src",
    "data",
    "scripts",
    "examples",
    "test",
    "docs",
    "README.md",
    "LICENSE",
    "embed.js",
    "vendor"
  ],
  "sideEffects": [
    "./src/style.css",
    "./embed.js",
    "./src/embed.js"
  ],
  "peerDependencies": {
    "leaflet": "^1.9.4"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/compiled.js && node --check src/compiled-layer.js && node --check src/outline-detail.js && node --check src/geometry.js && node --check src/state.js && node --check scripts/build-detail-atlas.mjs && node --check scripts/build-outline-overview.mjs && node --check scripts/build-compiled-atlas.mjs && node --check embed.js && node --check src/embed.js && node --check src/place-names.js && node --check src/places.js && node --check scripts/build-embed-data.mjs && node --check scripts/build-leaflet-engine.mjs && npm test",
    "pack:check": "npm pack --dry-run",
    "validate:data": "node scripts/validate-atlas.mjs",
    "build:data": "node scripts/build-atlas.mjs && npm run build:compiled",
    "build:compiled": "node scripts/build-compiled-atlas.mjs && npm run build:embed",
    "build:outlines": "node scripts/build-detail-atlas.mjs",
    "build:overview": "node scripts/build-outline-overview.mjs",
    "build:fragments": "node scripts/build-outline-fragments.mjs",
    "build:embed": "node scripts/build-embed-data.mjs",
    "test:embed": "node scripts/test-embed.mjs",
    "test:names": "node scripts/test-place-names.mjs",
    "test:refinement": "node scripts/test-embed-refinement.mjs",
    "test:fragments": "node scripts/test-outline-fragments.mjs",
    "build:engine": "node scripts/build-leaflet-engine.mjs",
    "check:engine": "node scripts/build-leaflet-engine.mjs --check",
    "test:embed:startup": "node scripts/test-embed-startup.mjs",
    "test:embed:updates": "node scripts/test-embed-updates.mjs",
    "test:flashing": "node scripts/test-map-flashing.mjs",
    "test:fills": "node scripts/test-map-fills.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "polygon-clipping": "0.15.7",
    "terser": "5.51.2"
  }
}
